Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);


/* =========================================
   DIMENSIONES EXACTAS DE LA BARRA
   ========================================= */

BAR_WIDTH = 600;
BAR_HEIGHT = 32;

BORDER = 2;
PADDING = 7;

SCREEN_WIDTH = Window.GetWidth();
SCREEN_HEIGHT = Window.GetHeight();

BAR_X = Math.Int((SCREEN_WIDTH - BAR_WIDTH) / 2);
BAR_Y = Math.Int((SCREEN_HEIGHT - BAR_HEIGHT) / 2);


/* =========================================
   TEXTO
   ========================================= */

title = Sprite();

title.SetPosition(
    BAR_X,
    BAR_Y - 50,
    10
);

title.SetImage(
    Image.Text(
        "Iniciando sistema...",
        1.0,
        0.65,
        0.0,
        "DejaVu Sans Mono 18"
    )
);


/* =========================================
   BORDE EXTERIOR
   ========================================= */

border = Sprite();

border.SetPosition(
    BAR_X,
    BAR_Y,
    0
);

border.SetImage(
    Image("amber-border.png")
);


/* =========================================
   RELLENO
   ========================================= */

progress = Sprite();

progress.SetPosition(
    BAR_X + PADDING,
    BAR_Y + PADDING,
    1
);


/* =========================================
   PORCENTAJE
   ========================================= */

percentage = Sprite();

percentage.SetPosition(
    BAR_X + BAR_WIDTH + 25,
    BAR_Y + 4,
    10
);


/* =========================================
   ACTUALIZACIÓN
   ========================================= */

fun update_progress(duration, value) {

    if (value < 0)
        value = 0;

    if (value > 1)
        value = 1;


    /*
     * Área interior REAL.
     *
     * 600 - 7 - 7 = 586 px
     */

    INNER_WIDTH = BAR_WIDTH - (PADDING * 2);

    INNER_HEIGHT = BAR_HEIGHT - (PADDING * 2);


    /*
     * Calculamos exclusivamente
     * el ancho que puede ocupar
     * el relleno.
     */

    FILL_WIDTH = Math.Int(
        INNER_WIDTH * value
    );


    /*
     * Si estamos en 0%, no mostramos
     * ningún relleno.
     */

    if (FILL_WIDTH <= 0) {

        progress.SetOpacity(0);

    } else {

        progress.SetOpacity(1);


        /*
         * Creamos una imagen nueva
         * exactamente del tamaño permitido.
         */

        fill_image = Image("amber-fill.png");

        fill_image = fill_image.Scale(
            FILL_WIDTH,
            INNER_HEIGHT
        );

        progress.SetImage(fill_image);
    }


    /*
     * Porcentaje.
     */

    PERCENT = Math.Int(value * 100);

    percentage.SetImage(
        Image.Text(
            PERCENT + "%",
            1.0,
            0.65,
            0.0,
            "DejaVu Sans Mono 18"
        )
    );
}


/* =========================================
   CONECTAR CON EL PROGRESO DE PLYMOUTH
   ========================================= */

Plymouth.SetBootProgressFunction(
    update_progress
);