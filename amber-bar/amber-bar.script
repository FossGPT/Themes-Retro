Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

amber = 1.0;
bar_width = Math.Int(screen_width * 0.60);
bar_height = 32;

bar_x = Math.Int((screen_width - bar_width) / 2);
bar_y = Math.Int(screen_height * 0.47);

/* Texto */
title = Sprite();
title.SetPosition(bar_x, bar_y - 45, 0);
title.SetOpacity(1);

title_image = Image.Text("Iniciando sistema...", 1.0, 0.65, 0.0, "DejaVu Sans Mono");
title.SetImage(title_image);

/* Marco de la barra */
border = Sprite();
border.SetPosition(bar_x, bar_y, 0);

border_image = Image("amber-border.png");
border.SetImage(border_image);

/* Parte que se llena */
progress = Sprite();
progress.SetPosition(bar_x + 4, bar_y + 4, 1);

progress_image = Image("amber-fill.png");
progress.SetImage(progress_image);

/* Porcentaje */
percentage = Sprite();
percentage.SetPosition(bar_x + bar_width + 25, bar_y + 3, 0);

percentage_image = Image.Text("0%", 1.0, 0.65, 0.0, "DejaVu Sans Mono");
percentage.SetImage(percentage_image);


/*
 * Plymouth nos proporciona el progreso del arranque.
 */
fun boot_progress(duration, progress_value) {
    if (progress_value < 0)
        progress_value = 0;

    if (progress_value > 1)
        progress_value = 1;

    fill_width = Math.Int((bar_width - 8) * progress_value);

    if (fill_width > 0) {
        progress_image = Image("amber-fill.png");
        progress_image = progress_image.Scale(fill_width, bar_height - 8);
        progress.SetImage(progress_image);
    }

    percent = Math.Int(progress_value * 100);

    percentage.SetImage(
        Image.Text(
            percent + "%",
            1.0,
            0.65,
            0.0,
            "DejaVu Sans Mono"
        )
    );
}

Plymouth.SetBootProgressFunction(boot_progress);