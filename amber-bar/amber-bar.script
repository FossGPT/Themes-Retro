Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

amber_r = 1.0;
amber_g = 0.65;
amber_b = 0.0;

bar_width = 600;
bar_height = 32;

bar_x = Math.Int((screen_width - bar_width) / 2);
bar_y = Math.Int(screen_height / 2);


/* Margen interior */
margin = 7;


/* =========================
   TEXTO
   ========================= */

title = Sprite();

title.SetPosition(
    bar_x,
    bar_y - 50,
    0
);

title.SetImage(
    Image.Text(
        "Iniciando sistema...",
        amber_r,
        amber_g,
        amber_b,
        "DejaVu Sans Mono 18"
    )
);


/* =========================
   BORDE
   ========================= */

border = Sprite();

border.SetPosition(
    bar_x,
    bar_y,
    0
);

border.SetImage(
    Image("amber-border.png")
);


/* =========================
   RELLENO
   ========================= */

progress = Sprite();

progress.SetPosition(
    bar_x + margin,
    bar_y + margin,
    1
);


/* =========================
   PORCENTAJE
   ========================= */

percentage = Sprite();

percentage.SetPosition(
    bar_x + bar_width + 20,
    bar_y + 3,
    0
);


/* =========================
   PROGRESO
   ========================= */

fun update_progress(duration, value) {

    if (value < 0)
        value = 0;

    if (value > 1)
        value = 1;


    /*
     * Área REAL disponible dentro
     * del borde.
     */

    inner_width = bar_width - (margin * 2);
    inner_height = bar_height - (margin * 2);


    /*
     * Ancho del relleno según
     * el porcentaje.
     */

    fill_width = Math.Int(
        inner_width * value
    );


    /*
     * Evitamos crear una imagen
     * con ancho 0.
     */

    if (fill_width < 1)
        fill_width = 1;


    /*
     * Crear el relleno.
     */

    fill = Image("amber-fill.png");

    fill = fill.Scale(
        fill_width,
        inner_height
    );


    progress.SetImage(fill);


    /*
     * Porcentaje.
     */

    percent = Math.Int(
        value * 100
    );


    percentage.SetImage(
        Image.Text(
            percent + "%",
            amber_r,
            amber_g,
            amber_b,
            "DejaVu Sans Mono 18"
        )
    );
}


/* =========================
   PLYMOUTH
   ========================= */

Plymouth.SetBootProgressFunction(
    update_progress
);