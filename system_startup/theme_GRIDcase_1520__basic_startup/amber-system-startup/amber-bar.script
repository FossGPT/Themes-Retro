// ============================================================
// VT320 AMBER PLYMOUTH THEME
// Ubuntu Server 22.04
// ============================================================

// ------------------------------------------------------------
// Colores
// Plymouth usa valores RGB de 0.0 a 1.0
// ------------------------------------------------------------

global.bg_r = 0.05098;       // #0D0904
global.bg_g = 0.03529;
global.bg_b = 0.01569;

global.amber_r = 1.0;        // #FFB000
global.amber_g = 0.69020;
global.amber_b = 0.0;

global.bright_r = 1.0;      // #FFD060
global.bright_g = 0.81569;
global.bright_b = 0.37647;

global.dark_r = 0.50196;    // #805800
global.dark_g = 0.34510;
global.dark_b = 0.0;

global.orange_r = 1.0;      // #FF9500
global.orange_g = 0.58431;
global.orange_b = 0.0;


// ------------------------------------------------------------
// Fondo
// ------------------------------------------------------------

Window.SetBackgroundTopColor(
    global.bg_r,
    global.bg_g,
    global.bg_b
);

Window.SetBackgroundBottomColor(
    global.bg_r,
    global.bg_g,
    global.bg_b
);


// ------------------------------------------------------------
// Estado
// ------------------------------------------------------------

global.frame = 0;
global.ready = 0;


// ------------------------------------------------------------
// WAIT
// ------------------------------------------------------------

wait.image = Image.Text(
    "WAIT",
    global.amber_r,
    global.amber_g,
    global.amber_b
);

wait.sprite = Sprite(wait.image);

wait.sprite.SetPosition(
    Window.GetX() + 24,
    Window.GetY() + 20,
    100
);

wait.sprite.SetOpacity(0.75);


// ------------------------------------------------------------
// Pantalla final
// ------------------------------------------------------------

final1.image = Image.Text(
    "VT320  OK",
    global.amber_r,
    global.amber_g,
    global.amber_b
);

final1.sprite = Sprite(final1.image);

final1.sprite.SetPosition(
    Window.GetX()
        + Window.GetWidth() / 2
        - final1.image.GetWidth() / 2,

    Window.GetY()
        + Window.GetHeight() * 0.27
        - final1.image.GetHeight() / 2,

    1000
);

final1.sprite.SetOpacity(0);


// ------------------------------------------------------------
// Texto inferior
// ------------------------------------------------------------

final2.image = Image.Text(
    "Firmware and Set-Up Screens Copyright (C) 1987",
    global.orange_r,
    global.orange_g,
    global.orange_b
);

final2.sprite = Sprite(final2.image);

final2.sprite.SetPosition(
    Window.GetX()
        + Window.GetWidth() / 2
        - final2.image.GetWidth() / 2,

    Window.GetY()
        + Window.GetHeight() * 0.415,

    1000
);

final2.sprite.SetOpacity(0);


// ------------------------------------------------------------

final3.image = Image.Text(
    "Digital Equipment Corporation",
    global.orange_r,
    global.orange_g,
    global.orange_b
);

final3.sprite = Sprite(final3.image);

final3.sprite.SetPosition(
    Window.GetX()
        + Window.GetWidth() / 2
        - final3.image.GetWidth() / 2,

    Window.GetY()
        + Window.GetHeight() * 0.455,

    1000
);

final3.sprite.SetOpacity(0);


// ------------------------------------------------------------
// Animación del WAIT
// ------------------------------------------------------------

fun refresh_callback ()
{
    global.frame++;

    if (global.ready == 0)
    {
        // 50 FPS aproximadamente
        time = global.frame / 50.0;

        // Pulso muy suave
        pulse =
            0.72
            + 0.28
            * (
                0.5
                + 0.5
                * Math.Sin(time * Math.Pi * 1.4)
            );

        wait.sprite.SetOpacity(pulse);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

Plymouth.SetRefreshRate(50);


// ------------------------------------------------------------
// Mensaje especial enviado por systemd
// ------------------------------------------------------------

fun display_message_callback (text)
{
    if (text == "__VT320_READY__")
    {
        global.ready = 1;

        // Apagar WAIT
        wait.sprite.SetOpacity(0);

        // Mostrar pantalla final
        final1.sprite.SetOpacity(1);
        final2.sprite.SetOpacity(1);
        final3.sprite.SetOpacity(1);
    }
}

Plymouth.SetDisplayMessageFunction(
    display_message_callback
);


// ------------------------------------------------------------
// Ocultar mensajes normales de Plymouth
// ------------------------------------------------------------

fun hide_message_callback (text)
{
}

Plymouth.SetHideMessageFunction(
    hide_message_callback
);


// ------------------------------------------------------------
// Cuando Plymouth recibe la orden de salir
// ------------------------------------------------------------

fun quit_callback ()
{
}

Plymouth.SetQuitFunction(quit_callback);